</system>
	<queries>
		<query>
			<formula>A[] not deadlock</formula>
			<comment>General sanity check.</comment>
		</query>
		<query>
			<formula>A[] (Lead.EvaluateJoin imply join_clock &lt;= JOIN_RESPONSE_DEADLINE)</formula>
			<comment>S1-T-03: engaging response within 500 ms.</comment>
		</query>
		<query>
			<formula>A[] (Joiner.ClosingDistance imply close_gap_clock &lt;= DISTANCE_CLOSING_DEADLINE)</formula>
			<comment>S1-T-02: distance closing starts within 500 ms.</comment>
		</query>
		<query>
			<formula>A[] (Lead.Platooning imply control_msg_clock &lt;= CONTROL_MESSAGE_PERIOD)</formula>
			<comment>S3-T-01: preceding truck sends control messages every 100 ms.</comment>
		</query>
		<query>
			<formula>A[] (Control.WaitControlMessage imply control_clock &lt;= CONTROL_PERIOD)</formula>
			<comment>S2-T-01: control message/update cycle is bounded by 100 ms.</comment>
		</query>
		<query>
			<formula>A[] (Control.UnsafeDistance imply unsafe_distance_clock &lt;= UNSAFE_DISTANCE_REACTION_DEADLINE)</formula>
			<comment>S2-T-02: unsafe-distance reaction starts within 100 ms.</comment>
		</query>
		<query>
			<formula>A[] (Control.BlockAcceleration imply acceleration_blocked)</formula>
			<comment>S2-S-02/S2-S-03: acceleration is blocked when lane following is lost.</comment>
		</query>
		<query>
			<formula>A[] (Control.DetectLaneTrack imply lane_clock &lt;= LANE_TRAJECTORY_DEADLINE)</formula>
			<comment>S2-T-03: lane/track detection is bounded by 100 ms.</comment>
		</query>
		<query>
			<formula>A[] (Control.LaneLost imply acceleration_blocked)</formula>
			<comment>S2-S-02/S2-S-03: lane/SVM loss blocks acceleration.</comment>
		</query>
		<query>
			<formula>A[] (Control.UpdateTrajectory imply lane_clock &lt;= LANE_TRAJECTORY_DEADLINE)</formula>
			<comment>S2-T-03: trajectory update is completed within the lane-control deadline.</comment>
		</query>
		<query>
			<formula>A[] (Control.ReduceSpeed imply reducing_speed)</formula>
			<comment>S2-T-02: unsafe distance leads to speed reduction.</comment>
		</query>
		<query>
			<formula>A[] (Control.LeavePlatooning imply !normal_platooning)</formula>
			<comment>S2 activity: if safe following is not possible, leave steady-state platooning.</comment>
		</query>
		<query>
			<formula>A[] (Comm.Monitoring imply stale_clock &lt;= STALE_MESSAGE_TIMEOUT)</formula>
			<comment>S3-T-02: missing control data becomes stale within 300 ms.</comment>
		</query>
		<query>
			<formula>A[] (Comm.StaleMessage imply degraded_clock &lt;= DEGRADED_ACTION_DEADLINE)</formula>
			<comment>S3-T-03: degraded-mode action starts within 500 ms.</comment>
		</query>
		<query>
			<formula>A[] (Comm.DegradedMode imply acceleration_blocked)</formula>
			<comment>S3 safety: stale communication cannot be used for acceleration.</comment>
		</query>
		<query>
			<formula>A[] (Comm.UseLocalSensors imply local_sensor_mode)</formula>
			<comment>S3-F-02: degraded mode uses local sensor data.</comment>
		</query>
		<query>
			<formula>A[] (Follower.EmergencyBraking imply !normal_platooning)</formula>
			<comment>S2-S-01: emergency braking stops normal platooning.</comment>
		</query>
		<query>
			<formula>E&lt;&gt; Follower.NormalPlatooning</formula>
			<comment>Reachability: platoon engaging can enter normal platooning.</comment>
		</query>
		<query>
			<formula>E&lt;&gt; Control.TrajectoryUpdated</formula>
			<comment>Reachability: valid SVM/lane result can update trajectory.</comment>
		</query>
		<query>
			<formula>E&lt;&gt; Control.LaneLost</formula>
			<comment>Reachability: lane/SVM loss path exists.</comment>
		</query>
		<query>
			<formula>E&lt;&gt; Control.LeavePlatooning</formula>
			<comment>Reachability: control can leave steady-state platooning when safe following is not possible.</comment>
		</query>
		<query>
			<formula>E&lt;&gt; Comm.DegradedMode</formula>
			<comment>Reachability: communication failure can enter degraded mode.</comment>
		</query>
		<query>
			<formula>E&lt;&gt; Follower.SafeExit</formula>
			<comment>Reachability: degraded following can request safe exit.</comment>
		</query>
		<query>
			<formula>E&lt;&gt; Follower.EmergencyBraking</formula>
			<comment>Reachability: emergency braking path exists.</comment>
		</query>
	</queries>
