	<system>
Lead = LeaderTruck();
Follower = FollowerTruck();
Comm = CommunicationLink();
Safety = SafetyController();

system Lead, Follower, Comm, Safety;
</system>
	<queries>
		<query>
			<formula>A[] not deadlock</formula>
			<comment>No deadlock.</comment>
		</query>
		<query>
			<formula>A[] (Lead.EvaluateJoin imply join_clock &lt;= JOIN_RESPONSE_DEADLINE)</formula>
			<comment>Join response time</comment>
			<result outcome="success" type="quality" timestamp="2026-06-18 22:07:17 +0300">
			</result>
		</query>
		<query>
			<formula>A[] (Follower.ClosingGap imply close_gap_clock &lt;= DISTANCE_CLOSING_DEADLINE)</formula>
			<comment>Gap closing time</comment>
			<result outcome="success" type="quality" timestamp="2026-06-18 21:44:22 +0300">
			</result>
		</query>
		<query>
			<formula>A[] (Lead.Platooning imply control_msg_clock &lt;= CONTROL_MESSAGE_PERIOD)</formula>
			<comment/>
			<result outcome="success" type="quality" timestamp="2026-06-18 21:44:23 +0300">
			</result>
		</query>
		<query>
			<formula>A[] (Comm.Monitoring imply stale_clock &lt;= STALE_MESSAGE_TIMEOUT)</formula>
			<comment>Communication timeout</comment>
			<result outcome="success" type="quality" timestamp="2026-06-18 21:44:25 +0300">
			</result>
		</query>
		<query>
			<formula>A[] (Comm.StaleData imply degraded_clock &lt;= DEGRADED_ACTION_DEADLINE)</formula>
			<comment>Degraded mode starts </comment>
			<result outcome="success" type="quality" timestamp="2026-06-18 21:44:26 +0300">
			</result>
		</query>
		<query>
			<formula>A[] (Follower.Degraded imply accel_blocked)</formula>
			<comment>Acceleration is forbiden in degraded mode.</comment>
			<result outcome="success" type="quality" timestamp="2026-06-18 21:44:27 +0300">
			</result>
		</query>
		<query>
			<formula>A[] (Safety.UnsafeGap imply accel_blocked)</formula>
			<comment>Unsafe gap blocks acceleration</comment>
			<result outcome="success" type="quality" timestamp="2026-06-18 21:44:28 +0300">
			</result>
		</query>
		<query>
			<formula>A[] (Safety.ReduceSpeed imply speed_reducing)</formula>
			<comment>Unsafe gap leads to speed reduction</comment>
			<result outcome="success" type="quality" timestamp="2026-06-18 21:44:29 +0300">
			</result>
		</query>
		<query>
			<formula>A[] (Follower.EmergencyBraking imply !platoon_active)</formula>
			<comment>Emergency braking stops platooning</comment>
			<result outcome="success" type="quality" timestamp="2026-06-18 21:44:29 +0300">
			</result>
		</query>
		<query>
			<formula>E&lt;&gt; Follower.Following</formula>
			<comment>Normal platooning</comment>
			<result outcome="success" type="quality" timestamp="2026-06-18 21:44:30 +0300">
			</result>
		</query>
		<query>
			<formula>E&lt;&gt; Comm.DegradedCommunication</formula>
			<comment>Degraded communication </comment>
			<result outcome="success" type="quality" timestamp="2026-06-18 22:07:11 +0300">
			</result>
		</query>
		<query>
			<formula>E&lt;&gt; Follower.SafeExit</formula>
			<comment>Safe exit </comment>
			<result outcome="success" type="quality" timestamp="2026-06-18 22:07:13 +0300">
			</result>
		</query>
		<query>
			<formula>E&lt;&gt; Safety.EmergencyBraking</formula>
			<comment>Emergency braking </comment>
			<result outcome="success" type="quality" timestamp="2026-06-18 22:07:15 +0300">
			</result>
		</query>
	</queries>
</nta>
