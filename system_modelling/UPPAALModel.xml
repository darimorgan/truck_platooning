<nta>
	<declaration><![CDATA[
// Truck Platooning UPPAAL model for Tasks 3-4.
//
// This model follows the compact style of "Final UPPAAL Model(old).xml".
// It specifies communication protocols and control behaviour only.
// Python/OpenCV/SVM internals belong to Task 5 integration and are not modelled here.

// ===== Timing requirements =====
const int CONTROL_PERIOD = 100;
const int CONTROL_MESSAGE_PERIOD = 100;
const int JOIN_RESPONSE_DEADLINE = 500;
const int DISTANCE_CLOSING_DEADLINE = 500;
const int UNSAFE_DISTANCE_REACTION_DEADLINE = 100;
const int LANE_TRAJECTORY_DEADLINE = 100;
const int STALE_MESSAGE_TIMEOUT = 300;
const int DEGRADED_ACTION_DEADLINE = 500;

// ===== Clocks =====
clock join_clock;
clock close_gap_clock;
clock control_msg_clock;
clock control_clock;
clock unsafe_distance_clock;
clock lane_clock;
clock stale_clock;
clock degraded_clock;

// ===== Platoon engaging communication =====
broadcast chan join_request;
broadcast chan join_accept;
broadcast chan join_reject;
broadcast chan start_distance_closing;
broadcast chan enter_platooning;

// ===== Steady-state platooning communication/control =====
broadcast chan control_msg;
broadcast chan distance_safe;
broadcast chan distance_unsafe;
broadcast chan svm_lane_ok;
broadcast chan svm_lane_lost;
broadcast chan trajectory_updated;
broadcast chan block_acceleration;
broadcast chan reduce_speed;
broadcast chan emergency_brake_msg;

// ===== Communication failure / degraded mode =====
broadcast chan comm_loss;
broadcast chan stale_message;
broadcast chan degraded_start;
broadcast chan local_sensor_control;
broadcast chan collision_risk;
broadcast chan safe_following_not_possible;
broadcast chan safe_exit_request;
broadcast chan comm_restore;
broadcast chan restored_data_valid;
broadcast chan restored_data_invalid;
broadcast chan return_to_normal;

// ===== State used by verification queries =====
bool normal_platooning = false;
bool communication_ok = true;
bool data_stale = false;
bool degraded_mode = false;
bool local_sensor_mode = false;
bool safe_exit_active = false;
bool acceleration_blocked = false;
bool reducing_speed = false;
bool emergency_braking = false;
bool safe_distance_ok = true;
bool lane_ok = true;
bool trajectory_ok = false;

// Control assumptions:
// - SVM/line-follower output is abstracted as svm_lane_ok or svm_lane_lost.
// - A valid lane result is followed by trajectory_updated within 100 ms.
// - Stale communication data must not be used for acceleration.
// - During degraded mode, local sensor data is used for distance control.
]]></declaration>
