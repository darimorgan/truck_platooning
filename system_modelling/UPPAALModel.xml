<nta>
	<declaration>
// Timing constants
const int CONTROL_PERIOD = 100;
const int CONTROL_MESSAGE_PERIOD = 100;
const int JOIN_RESPONSE_DEADLINE = 500;
const int DISTANCE_CLOSING_DEADLINE = 500;
const int UNSAFE_DISTANCE_REACTION_DEADLINE = 100;
const int STALE_MESSAGE_TIMEOUT = 300;
const int DEGRADED_ACTION_DEADLINE = 500;

// Clocks
clock join_clock;
clock close_gap_clock;
clock control_msg_clock;
clock control_clock;
clock unsafe_distance_clock;
clock stale_clock;
clock degraded_clock;

// Handshake channels
chan join_req;
chan join_ok;
chan join_fail;
chan degraded_on;
chan safe_exit_req;
chan return_normal;

// Broadcast channels
broadcast chan enter_platooning;
broadcast chan status_msg;
broadcast chan emergency_brake;

// State variables
bool platoon_active = false;
bool comm_ok = true;
bool degraded = false;
bool braking = false;
bool accel_blocked = false;
bool gap_safe = true;
bool speed_reducing = false;
</declaration>
